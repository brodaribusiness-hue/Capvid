<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151517"
    android:orientation="vertical">

    <!-- Template / Color / Font / Breaks top tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tabTemplate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:text="Template" />

        <TextView
            android:id="@+id/tabColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:textColor="#7A7A80"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:text="Color" />

        <TextView
            android:id="@+id/tabFont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:textColor="#7A7A80"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:text="Font" />

        <TextView
            android:id="@+id/tabBreaks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:textColor="#7A7A80"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:text="Breaks" />
    </LinearLayout>

    <!-- ===== TEMPLATES panel (category chips + template cards) ===== -->
    <LinearLayout
        android:id="@+id/templatesPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/templateList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <!-- ===== COLOR / FONT / BREAKS panels (one visible at a time) ===== -->
    <include
        android:id="@+id/colorPanel"
        layout="@layout/panel_color"
        android:visibility="gone" />

    <include
        android:id="@+id/fontsPanel"
        layout="@layout/panel_fonts"
        android:visibility="gone" />

    <include
        android:id="@+id/breaksPanel"
        layout="@layout/panel_breaks"
        android:visibility="gone" />

    <!-- Save as custom template -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp">

        <CheckBox
            android:id="@+id/checkSaveAsCustom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save as custom template"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Cancel / Apply -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="14dp"
            android:text="Cancel"
            android:textColor="#B0B0B5"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_apply_button"
            android:gravity="center"
            android:padding="14dp"
            android:text="Apply"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</LinearLayout>
